<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.istat.powermetrics.helper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/opt/istatserverlinux/libexec/istat-powermetrics-helper</string>
  </array>

  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>10</integer>

  <key>StandardOutPath</key><string>/var/log/istat-pm.out</string>
  <key>StandardErrorPath</key><string>/var/log/istat-pm.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict></plist>
